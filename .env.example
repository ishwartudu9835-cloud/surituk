# ===== Required =====
DATABASE_URL=postgres://user:password@host/surituk?sslmode=require
SESSION_SECRET=put-a-long-random-string-here
# Your website address (used for payment return + links)
FRONTEND_URL=https://surituk.pages.dev
# This API's own public address (used for uploaded file links when not using R2)
API_PUBLIC_URL=https://surituk-api.onrender.com
# Emails that get the Admin panel (comma separated)
ADMIN_EMAILS=ishwartudu9835@gmail.com

# ===== Email OTP (Gmail SMTP with an App Password) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Surituk <yourgmail@gmail.com>

# ===== Google login =====
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ===== PhonePe Payment Gateway =====
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox            # change to production after testing
PHONEPE_WEBHOOK_USER=
PHONEPE_WEBHOOK_PASS=

# ===== File storage: Cloudflare R2 (needed in production) =====
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=surituk-public
S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
S3_PRIVATE_BUCKET=surituk-private

# ===== Business rules =====
COMMISSION_PERCENT=20
MIN_PAYOUT_RUPEES=500

# ===== Website build (Cloudflare Pages) — these start with VITE_ =====
# VITE_API_URL=https://surituk-api.onrender.com
# VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# VITE_ADSENSE_SLOT_BANNER=1234567890
# VITE_ADSENSE_SLOT_IN_ARTICLE=1234567890
# VITE_ADSENSE_SLOT_READER=1234567890
